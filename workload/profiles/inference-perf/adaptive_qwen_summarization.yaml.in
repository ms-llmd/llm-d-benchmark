# Qwen-PINNED load for the adaptive experiment. Exact model_name -> the IPP
# model-group-name-filter pins every request to the Qwen pool. Same summarization shape, tokenizer
# and rate as the shared and Gemma profiles (replaces adaptive_qwen_codecomp, whose short-output
# code-completion shape made the two pools' latencies incomparable). One 300s poisson stage; the
# driver launches it in the stages where Qwen-only is "on" (-1, 3, 4).
load:
  type: poisson
  interval: 0
  request_timeout: 120
  stages:
  # 10 rps against a ceiling of ~15.7 rps MEASURED on this exact shape (ramp 12/14/16/18: output
  # rate 11.4/13.8/15.4/15.7, knee between 14 and 16 where TTFT goes 0.231s -> 1.235s and ITL rises
  # 0.029 -> 0.076, i.e. genuinely compute-bound, unlike Gemma). 10 rps = 64%, comfortable headroom.
  # --max-num-seqs 64 has been REMOVED from the stack: at 256-token outputs this shape needs ~101
  # concurrent sequences at 10 rps (peak 296 observed at 18 rps), so the cap was the binding
  # constraint and cost 2.7x on e2e and 63x on TTFT. No wedge recurred at any rate up to 18.
  - {rate: 10.0, duration: 300}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "Qwen/Qwen3.6-35B-A3B-FP8"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  # each pinned profile uses its OWN model's tokenizer so the pool receives exactly the ~2048
  # tokens the shape specifies. Generating with Qwen's tokenizer for both inflated Gemma's real
  # input by 39% (server saw 2868 tokens vs 2062 generated, token_count_mismatches 1318), which
  # alone pushed Gemma's prefill to ~96% of its ceiling. The shared "auto" profile can only carry
  # one tokenizer, so shared requests landing on Gemma still get inflated -- unavoidable.
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  # per_request IS needed here: it is the only harness-side per-request record (start/end time,
  # error, output tokens). It embeds the full streamed response, so expect ~1-2 GB per run at
  # 3000 requests of this shape and a slow collection step. stage.sh slims it to
  # per_request_slim.json right after archiving; the fat original is gitignored.
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
