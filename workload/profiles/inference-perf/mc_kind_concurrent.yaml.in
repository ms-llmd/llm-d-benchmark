# Concurrency ladder for the Kind multi-cluster routing experiment.
#
# Sized for llm-d-inference-sim leaves that have been deliberately slowed
# (--time-to-first-token=2000 --max-num-seqs=2): 1+3 pods cap out around 8
# concurrent requests, so stage 2 runs well past saturation and queues build.
# That queueing is the whole point -- the multicluster scorers read queue depth
# and KV utilization, and below saturation every cluster reports 0 and ties.
#
# Prompts stay short because the sim scenario pins maxModelLen: 1024.
load:
  type: concurrent
  stages:
    - concurrency_level: 8
      num_requests: 80
    - concurrency_level: 32
      num_requests: 320
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  pretrained_model_name_or_path: REPLACE_ENV_LLMDBENCH_DEPLOY_CURRENT_MODEL
data:
  type: random
  input_distribution:
    min: 128
    max: 256
    mean: 192
    std: 32
  output_distribution:
    min: 16
    max: 48
    mean: 32
    std: 8
report:
  request_lifecycle:
    summary: true
    per_stage: true
    per_request: true
storage:
  local_storage:
    path: /workspace
