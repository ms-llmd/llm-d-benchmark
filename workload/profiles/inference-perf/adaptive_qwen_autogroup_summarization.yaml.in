# Qwen-PINNED load for the adaptive experiment. model_name "auto/qwen" -> the IPP
# auto-group-model-name-filter pins every request to the Qwen pool (no spill to Gemma). Same
# summarization shape, tokenizer and rate as the shared and Gemma profiles. One 300s poisson stage;
# the driver launches it in the stages where Qwen-only is "on" (-1, 3, 4).
load:
  type: poisson
  interval: 0
  request_timeout: 120
  stages:
  - {rate: 10.0, duration: 300}
api:
  type: completion
  streaming: true
server:
  type: vllm
  model_name: "auto/qwen"
  base_url: REPLACE_ENV_LLMDBENCH_HARNESS_STACK_ENDPOINT_URL
  ignore_eos: true
tokenizer:
  # each pinned profile uses its OWN model's tokenizer so the pool receives exactly the ~2048
  # tokens the shape specifies (see adaptive_gemma_autogroup_summarization.yaml.in).
  pretrained_model_name_or_path: Qwen/Qwen3.6-35B-A3B-FP8
data:
  type: random
  input_distribution:  {min: 1024, max: 4096, mean: 2048, std_dev: 512, total_count: 200}
  output_distribution: {min: 128,  max: 512,  mean: 256,  std_dev: 64,  total_count: 200}
report:
  request_lifecycle: {summary: true, per_stage: true, per_request: true}
storage:
  local_storage: {path: /workspace}
