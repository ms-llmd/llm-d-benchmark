# OpenShift dual-pool Qwen3-8B IPP -- STANDUP/TEARDOWN spec (both pools, 2+3 replicas).
# See scenarios/cicd/ocp-qwen3-8b-dual-pool.yaml. Use cicd/ocp-qwen3-8b-dual-pool-run
# for `run` (single harness; HTTPRoute splits load across both pools).

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-qwen3-8b-dual-pool.yaml
