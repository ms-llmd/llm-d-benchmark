# OpenShift dual-pool Qwen3-8B -- single-stack RUN spec (one harness).
# Standup/teardown with cicd/ocp-qwen3-8b-dual-pool (BOTH pools); use THIS spec only
# for `run` so one harness drives load through the shared gateway and the HTTPRoute
# splits across both pools.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-qwen3-8b-dual-pool-run.yaml
