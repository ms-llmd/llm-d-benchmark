# OpenShift Qwen3-8B + Qwen3-32B -- single-stack RUN spec (summarizer harness).
# Standup/teardown with cicd/ocp-qwen3-8b-32b (BOTH pools); use THIS spec only
# for `run` so a single Qwen3-8B summarizer harness drives load through the
# shared gateway. IPP routes across both pools regardless of the requested model.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-qwen3-8b-32b-summarizer.yaml
