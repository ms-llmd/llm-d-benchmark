# Kind Simulated Accelerators -- Multi-Model CI/CD Specification
# Two InferencePools (facebook/opt-125m, facebook/opt-350m) on Kind, no GPU.
# HTTPRoutes applied per-pool by gen_httproutes.sh (header-match on
# X-Gateway-Base-Model-Name), requires IPP in the data path.
# See scenarios/cicd/kind-sim-multi.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/kind-sim-multi.yaml
