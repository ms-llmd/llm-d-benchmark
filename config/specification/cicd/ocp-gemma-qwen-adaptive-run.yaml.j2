# Adaptive-routing RUN spec -- single stack (harness only; pools already stood up via the
# 2-stack ocp-gemma-qwen-adaptive scenario). One stack => one execution per llmdbenchmark run,
# so each toggle stage is a discrete, non-overlapping set of runs.
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

template_dir:
  path: {{ base_dir }}/config/templates/jinja

scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/ocp-gemma-qwen-adaptive-run.yaml
