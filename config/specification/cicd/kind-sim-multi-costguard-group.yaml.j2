# Kind Simulated Accelerators -- Multi-Model CI/CD Specification (CostGuard, group routing)
# Sibling of kind-sim-multi.yaml.j2; same two-sim stack (opt-125m + opt-350m)
# but harness profile sends {"model":"auto/fast"} to exercise IPP's
# model-group-name-filter group branch. See
# scenarios/cicd/kind-sim-multi-costguard-group.yaml for details.

# [REQUIRED]
{% set base_dir = base_dir | default('../') -%}
base_dir: {{ base_dir }}

# [REQUIRED]
values_file:
  path: {{ base_dir }}/config/templates/values/defaults.yaml

# [REQUIRED]
template_dir:
  path: {{ base_dir }}/config/templates/jinja

# [OPTIONAL]
scenario_file:
  path: {{ base_dir }}/config/scenarios/cicd/kind-sim-multi-costguard-group.yaml
